SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your_anon_public_key

OPENROUTER_API_KEY=sk-or-v1-your_key
OPENROUTER_MODEL=google/gemini-3.5-flash
# optional second model tried if the first one fails (leave empty to skip)
OPENROUTER_FALLBACK_MODEL=

GROQ_API_KEY=gsk_your_key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant

# run the 4 CrewAI agents automatically after each receipt upload
RUN_AGENTS_ON_UPLOAD=true
# comma separated list of frontend URLs allowed to call the API
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
